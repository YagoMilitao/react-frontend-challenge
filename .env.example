# Token de leitura da API do TMDB (Bearer token / API Read Access Token).
# Obtenha gratuitamente em https://www.themoviedb.org/settings/api após criar uma conta.
# SEM prefixo VITE_ de propósito: é lido só pelo proxy server-side
# (api/tmdb/[...path].ts em prod, middleware do vite.config.ts em dev),
# nunca pelo código do client — assim não vai parar no bundle JS do navegador.
TMDB_API_READ_TOKEN=

# Opcionais — já têm defaults corretos em src/shared/config/env.ts, só sobrescreva se necessário.
# VITE_TMDB_BASE_URL=/api/tmdb
# VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
